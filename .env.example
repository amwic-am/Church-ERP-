# Copy to .env.local and fill in from your Supabase project
# Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Public site URL used for auth redirect links and SEO canonical tags
VITE_SITE_URL=http://localhost:5173

# Storage bucket used by the media library (created by migration 0012)
VITE_MEDIA_BUCKET=media
